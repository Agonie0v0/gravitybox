{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege capabilities for GravityBox Windows desktop windows",
  "windows": ["main", "tray"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:event:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
